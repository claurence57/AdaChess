   ------------------
   -- Key helpers --
   ------------------

   -- Shifts by one file / rank (board layout a1 = bit 0, +1 file = +1 bit,
   -- +1 rank = +8 bits). Masks prevent wrap-around at the board edges.
   function East_1 (B : in Bitboard) return Bitboard is
     ((B and 16#7F7F7F7F7F7F7F7F#) * 2);
   function West_1 (B : in Bitboard) return Bitboard is
     ((B and 16#FEFEFEFEFEFEFEFE#) / 2);
   function North_1 (B : in Bitboard) return Bitboard is
     ((B and 16#00FFFFFFFFFFFFFF#) * 256);
   function South_1 (B : in Bitboard) return Bitboard is
     (B / 256);

   -- Polyglot piece index: 2 * kind (Pawn..King) + color (0 = White).
   Kind_Index : constant array (Kind_Type) of Natural :=
     (Pawn => 0, Knight => 1, Bishop => 2, Rook => 3, Queen => 4, King => 5);

   function Polyglot_Key (Position : in Position_Type) return Bitboard is
      Key : Bitboard := 0;
      B   : Bitboard;
   begin
      for Piece in Piece_Type loop
         B := Position.Pieces (Piece);
         while B /= 0 loop
            declare
               Sq  : constant Square_Type := Lowest_Bit (B);
               Col : constant Natural :=
                 (if Color (Piece) = White then 1 else 0);
               Idx : constant Natural :=
                 64 * (2 * Kind_Index (Kind (Piece)) + Col) + Sq;
            begin
               Key := Key xor Polyglot_Random (Idx);
            end;
            B := B and (B - 1);
         end loop;
      end loop;

      if Position.Castle (White, King_Side) then
         Key := Key xor Polyglot_Random (768);
      end if;
      if Position.Castle (White, Queen_Side) then
         Key := Key xor Polyglot_Random (769);
      end if;
      if Position.Castle (Black, King_Side) then
         Key := Key xor Polyglot_Random (770);
      end if;
      if Position.Castle (Black, Queen_Side) then
         Key := Key xor Polyglot_Random (771);
      end if;

      -- En passant is hashed only when a pawn of the side to move can
      -- actually capture (legality of the capture is irrelevant), matching
      -- the reference Polyglot implementation.
      if Position.En_Passant /= Ep_None then
         declare
            Ep_Sq  : constant Square_Type := Square_Type (Position.En_Passant);
            Ep_Bit : constant Bitboard := Bit (Ep_Sq);
            Att    : Bitboard;
         begin
            if Position.Side = White then
               Att := South_1 (East_1 (Ep_Bit)) or South_1 (West_1 (Ep_Bit));
            else
               Att := North_1 (East_1 (Ep_Bit)) or North_1 (West_1 (Ep_Bit));
            end if;
            if (Att and Position.Pieces (Make (Position.Side, Pawn))) /= 0 then
               Key := Key xor Polyglot_Random (772 + File_Of (Ep_Sq));
            end if;
         end;
      end if;

      if Position.Side = White then
         Key := Key xor Polyglot_Random (780);
      end if;
      return Key;
   end Polyglot_Key;

   ------------------
   -- Book storage --
   ------------------

   type Book_Entry is record
      Key    : Bitboard := 0;
      Move   : Natural := 0;
      Weight : Natural := 0;
   end record;
   type Book_Array is array (Natural range <>) of Book_Entry;
   type Book_Access is access Book_Array;
   procedure Free is new Ada.Unchecked_Deallocation (Book_Array, Book_Access);
   Book : Book_Access := null;

   package Random_Weight is new Ada.Numerics.Discrete_Random (Natural);
   Gen : Random_Weight.Generator;

   function Book_Loaded return Boolean is (Book /= null);

   procedure Close_Book is
   begin
      if Book /= null then
         Free (Book);
      end if;
   end Close_Book;

   procedure Open_Book (File_Name : in String; Ok : out Boolean) is
      use Ada.Streams;
      use Ada.Streams.Stream_IO;
      F    : File_Type;
      Size : Count;
      N    : Natural;
   begin
      Ok := False;
      Close_Book;
      begin
         Open (F, In_File, File_Name);
      exception
         when others => return;
      end;

      Size := Stream_IO.Size (F);
      if Size < 16 then
         Close (F);
         return;
      end if;
      N := Natural (Size / 16);

      Book := new Book_Array (0 .. N - 1);
      for I in 0 .. N - 1 loop
         declare
            Buf  : Stream_Element_Array (1 .. 16);
            Off  : Stream_Element_Offset := 1;
            Last : Stream_Element_Offset;
         begin
            while Off <= 16 loop
               Read (F, Buf (Off .. 16), Last);
               Off := Last + 1;
            end loop;
            Book (I).Key := 0;
            for J in 0 .. 7 loop
               Book (I).Key :=
                 Book (I).Key * 256
                 + Bitboard (Buf (Stream_Element_Offset (J + 1)));
            end loop;
            Book (I).Move :=
              Natural (Buf (9)) * 256 + Natural (Buf (10));
            Book (I).Weight :=
              Natural (Buf (11)) * 256 + Natural (Buf (12));
         end;
      end loop;

      Close (F);
      Random_Weight.Reset (Gen);
      Ok := True;
   end Open_Book;

   ------------
   -- Decode --
   ------------

   -- Turn a raw Polyglot move into a legal Move_Type of Position (empty and
   -- False when the move is not legal, e.g. a stale book entry).
   function Decode (Position : in Position_Type;
                    Raw      : in Natural;
                    Move     : out Move_Type) return Boolean
   is
      From  : constant Square_Type := Square_Type ((Raw / 64) mod 64);
      To    : constant Square_Type := Square_Type (Raw mod 64);
      Promo : constant Natural := (Raw / 4096) mod 8;
      Moves : Move_List;
      Count : Natural;
   begin
      Move := Empty_Move;
      Generate_Legal_Moves (Position, Moves, Count);
      for I in 1 .. Count loop
         if Moves (I).From = From and then Moves (I).To = To then
            if Promo = 0 then
               if Moves (I).Flag /= Promotion then
                  Move := Moves (I);
                  return True;
               end if;
            elsif Moves (I).Flag = Promotion then
               declare
                  K : constant Kind_Type := Kind (Moves (I).Promotion);
               begin
                  if (Promo = 1 and then K = Knight)
                    or else (Promo = 2 and then K = Bishop)
                    or else (Promo = 3 and then K = Rook)
                    or else (Promo = 4 and then K = Queen)
                  then
                     Move := Moves (I);
                     return True;
                  end if;
               end;
            end if;
         end if;
      end loop;
      return False;
   end Decode;

   -----------
   -- Probe --
   -----------

   function Probe (Position : in Position_Type; Move : out Move_Type)
     return Boolean
   is
      K           : constant Bitboard := Polyglot_Key (Position);
      Lo, Hi, Mid : Natural;
      First, Last : Natural;
      Sum, Pick   : Natural;
   begin
      Move := Empty_Move;
      if Book = null then
         return False;
      end if;

      -- Lower bound of K in the key-sorted table.
      Lo := 0;
      Hi := Book'Length;
      while Lo < Hi loop
         Mid := Lo + (Hi - Lo) / 2;
         if Book (Mid).Key < K then
            Lo := Mid + 1;
         else
            Hi := Mid;
         end if;
      end loop;
      if Lo >= Book'Length or else Book (Lo).Key /= K then
         return False;
      end if;

      First := Lo;
      Last := Lo;
      while Last < Book'Length and then Book (Last).Key = K loop
         Last := Last + 1;
      end loop;

      -- Weighted random choice among the entries of this position.
      Sum := 0;
      for I in First .. Last - 1 loop
         Sum := Sum + Natural'Max (Book (I).Weight, 1);
      end loop;
      Pick := Random_Weight.Random (Gen) mod Sum;
      declare
         Chosen : Natural := First;
      begin
         for I in First .. Last - 1 loop
            declare
               W : constant Natural := Natural'Max (Book (I).Weight, 1);
            begin
               if Pick < W then
                  Chosen := I;
                  exit;
               end if;
               Pick := Pick - W;
            end;
         end loop;
         return Decode (Position, Book (Chosen).Move, Move);
      end;
   end Probe;

end BBChess.Polyglot;
